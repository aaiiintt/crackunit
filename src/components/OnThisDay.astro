---
import type { Post } from "../lib/posts";
interface Props { posts: Post[] }
const { posts } = Astro.props;
const archive = posts.map((post) => ({
  title: post.data.title,
  date: post.data.date.toISOString(),
  year: post.data.date.getFullYear(),
  month: post.data.date.getMonth() + 1,
  day: post.data.date.getDate(),
  permalink: post.data.permalink,
  excerpt: post.data.excerpt ?? "",
  image: post.data.featuredImage ?? "",
}));
---
<section class="otd" data-archive data-posts={JSON.stringify(archive)}>
  <div class="otd-intro">
    <p class="eyebrow">The Crack Unit time machine</p>
    <h1>On this day</h1>
    <p class="lede">A living shelf of everything written here on this date, across the years.</p>
  </div>

  <div class="otd-toolbar" aria-label="Archive controls">
    <button class="day-control" type="button" data-previous aria-label="Show the previous archive day">← <span>Previous day</span></button>
    <div class="date-readout" aria-live="polite">
      <span class="date-kicker" data-kicker>Today in the archive</span>
      <strong data-date>Loading the archive…</strong>
    </div>
    <button class="day-control" type="button" data-next aria-label="Show the next archive day"><span>Next day</span> →</button>
  </div>

  <div class="shelf-window" data-window tabindex="0" aria-label="Posts from this date and nearby days">
    <div class="shelf" data-shelf></div>
  </div>
  <p class="shelf-hint">Drag the shelf, use the arrows, or press ← → to travel through time.</p>
</section>

<script define:vars={{ archive }}>
  const root = document.querySelector("[data-archive]");
  if (root) {
    const groups = new Map();
    for (const post of archive) {
      const key = `${post.month}-${post.day}`;
      if (!groups.has(key)) groups.set(key, []);
      groups.get(key).push(post);
    }
    const keys = [...groups.keys()].sort((a, b) => {
      const [am, ad] = a.split("-").map(Number); const [bm, bd] = b.split("-").map(Number);
      return am - bm || ad - bd;
    });
    const today = new Date();
    const todayKey = `${today.getMonth() + 1}-${today.getDate()}`;
    let index = keys.indexOf(todayKey);
    if (index < 0) {
      const target = (today.getMonth() + 1) * 100 + today.getDate();
      index = keys.reduce((closest, key, i) => {
        const [month, day] = key.split("-").map(Number);
        const [cm, cd] = keys[closest].split("-").map(Number);
        return Math.abs(month * 100 + day - target) < Math.abs(cm * 100 + cd - target) ? i : closest;
      }, 0);
    }

    const shelf = root.querySelector("[data-shelf]");
    const date = root.querySelector("[data-date]");
    const kicker = root.querySelector("[data-kicker]");
    const render = () => {
      const key = keys[index];
      const [month, day] = key.split("-").map(Number);
      const entries = groups.get(key) ?? [];
      const label = new Date(2020, month - 1, day).toLocaleDateString("en-GB", { day: "numeric", month: "long" });
      date.textContent = label;
      kicker.textContent = key === todayKey ? "Today in the archive" : "Nearby day in the archive";
      shelf.innerHTML = `<div class="shelf-track">${entries.length ? entries.map((post, cardIndex) => `
        <article class="archive-card ${cardIndex === 0 ? "is-featured" : ""}">
          <div class="card-media">${post.image ? `<img src="${post.image}" alt="" loading="lazy" />` : `<div class="card-art" aria-hidden="true"><span>${post.year}</span></div>`}</div>
          <div class="card-body">
            <div class="card-meta"><time datetime="${post.date}">${post.year}</time><span>${entries.length > 1 ? `${String(cardIndex + 1).padStart(2, "0")} of ${String(entries.length).padStart(2, "0")}` : "Archive note"}</span></div>
            <h2><a href="${post.permalink}">${post.title}</a></h2>
            ${post.excerpt ? `<p>${post.excerpt}</p>` : ""}
            <a class="read-link" href="${post.permalink}">Read post <span aria-hidden="true">↗</span></a>
          </div>
        </article>`).join("") : `<div class="empty-card"><span class="empty-mark" aria-hidden="true">∅</span><h2>No post on this day</h2><p>Keep travelling. The archive is full of odd turns and unexpected finds.</p></div>`}</div>`;
      shelf.setAttribute("aria-label", `${label}: ${entries.length} posts`);
    };
    const move = (direction) => { index = (index + direction + keys.length) % keys.length; render(); };
    root.querySelector("[data-previous]").addEventListener("click", () => move(-1));
    root.querySelector("[data-next]").addEventListener("click", () => move(1));
    root.querySelector("[data-window]").addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") { event.preventDefault(); move(-1); }
      if (event.key === "ArrowRight") { event.preventDefault(); move(1); }
    });
    render();
  }
</script>

<style>
  .otd { max-width: 100%; overflow: hidden; }
  .otd-intro { max-width: 40rem; margin: 0 auto 3rem; text-align: center; }
  .eyebrow { margin: 0 0 .75rem; color: var(--accent); font: 700 .72rem/1.2 var(--sans); letter-spacing: .16em; text-transform: uppercase; }
  .otd h1 { font-size: clamp(3rem, 8vw, 6.5rem); letter-spacing: -.07em; line-height: .9; margin: 0; text-wrap: balance; }
  .lede { max-width: 30rem; margin: 1.25rem auto 0; color: var(--muted); font-size: 1.1rem; text-wrap: balance; }
  .otd-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; max-width: 70rem; margin: 0 auto 1.25rem; }
  .date-readout { text-align: center; }
  .date-readout strong { display: block; font: 600 clamp(1.35rem, 3vw, 2rem)/1.1 var(--serif); }
  .date-kicker { display: block; margin-bottom: .35rem; color: var(--muted); font: .7rem var(--sans); letter-spacing: .12em; text-transform: uppercase; }
  .day-control { border: 1px solid var(--rule); background: transparent; color: var(--fg); padding: .7rem .9rem; cursor: pointer; font: .78rem var(--sans); letter-spacing: .04em; touch-action: manipulation; }
  .day-control:hover, .day-control:focus-visible { border-color: var(--accent); color: var(--accent); }
  .day-control:focus-visible, .shelf-window:focus-visible, .archive-card a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .shelf-window { overflow-x: auto; overflow-y: hidden; padding: .75rem max(1.25rem, calc((100vw - 76rem) / 2)) 2.5rem; outline: none; overscroll-behavior-x: contain; scrollbar-width: thin; scroll-snap-type: x mandatory; }
  :global(.shelf-track) { display: flex; align-items: stretch; justify-content: flex-start; gap: 1.5rem; min-height: 36rem; min-width: max-content; }
  :global(.archive-card), :global(.empty-card) { flex: 0 0 min(31vw, 25rem); min-width: 20rem; border: 1px solid var(--rule); background: color-mix(in srgb, var(--fg) 3%, var(--bg)); box-shadow: 0 1.5rem 3rem color-mix(in srgb, var(--fg) 9%, transparent); scroll-snap-align: center; }
  :global(.archive-card) { display: grid; grid-template-rows: 13rem 1fr; }
  :global(.archive-card.is-featured) { flex-basis: min(43vw, 36rem); border-color: color-mix(in srgb, var(--accent) 55%, var(--rule)); box-shadow: 0 2rem 4rem color-mix(in srgb, var(--accent) 12%, transparent); }
  :global(.card-media), :global(.archive-card img), :global(.card-art) { width: 100%; height: 100%; min-height: 0; object-fit: cover; }
  :global(.card-media) { overflow: hidden; background: color-mix(in srgb, var(--fg) 8%, var(--bg)); }
  :global(.archive-card img) { display: block; filter: saturate(.8); }
  :global(.card-art) { display: flex; align-items: flex-end; padding: 1.25rem; color: var(--bg); background: linear-gradient(145deg, var(--accent), var(--fg)); }
  :global(.card-art span) { font: 700 3.5rem/1 var(--sans); letter-spacing: -.08em; opacity: .75; }
  :global(.card-body) { display: flex; min-width: 0; flex-direction: column; padding: clamp(1.25rem, 3vw, 2.25rem); }
  :global(.card-meta) { display: flex; justify-content: space-between; gap: 1rem; color: var(--muted); font: .7rem var(--sans); letter-spacing: .08em; text-transform: uppercase; font-variant-numeric: tabular-nums; }
  :global(.card-body h2) { margin: auto 0 1rem; min-width: 0; font-size: clamp(1.6rem, 3vw, 2.5rem); line-height: 1.02; text-wrap: balance; overflow-wrap: anywhere; }
  :global(.card-body h2 a) { color: var(--fg); text-decoration: none; }
  :global(.card-body h2 a:hover) { color: var(--accent); }
  :global(.card-body p) { display: -webkit-box; overflow: hidden; margin: 0 0 1.5rem; color: var(--muted); font-size: .95rem; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 5; }
  :global(.read-link) { color: var(--accent); font: 700 .78rem var(--sans); text-decoration: none; letter-spacing: .04em; }
  :global(.read-link span) { display: inline-block; margin-left: .35rem; transition: transform .2s; }
  :global(.read-link:hover span) { transform: translate(2px, -2px); }
  :global(.empty-card) { display: flex; flex-direction: column; justify-content: center; padding: 3rem; text-align: center; }
  :global(.empty-mark) { color: var(--accent); font: 3rem var(--serif); }
  :global(.empty-card h2) { margin: 1rem 0 .5rem; font-size: 2rem; }
  :global(.empty-card p) { margin: 0 auto; max-width: 22rem; color: var(--muted); }
  .shelf-hint { margin: 0; text-align: center; color: var(--muted); font: .72rem var(--sans); letter-spacing: .06em; }
  @media (max-width: 40rem) {
    .otd-intro { margin-bottom: 2rem; }
    .otd-toolbar { align-items: stretch; }
    .day-control { padding: .6rem; }
    .day-control span { display: none; }
    .shelf-window { padding-inline: 1rem; }
    :global(.shelf-track) { justify-content: flex-start; gap: .75rem; }
    :global(.archive-card), :global(.archive-card.is-featured) { flex-basis: min(84vw, 25rem); min-width: 0; }
    :global(.archive-card) { grid-template-rows: 10rem 1fr; }
    :global(.card-body h2) { margin-top: 2rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .read-link span { transition: none; }
    .shelf-window { scroll-behavior: auto; }
  }
</style>
