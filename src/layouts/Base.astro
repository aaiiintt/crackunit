---
interface Props {
  title: string;
  description?: string;
  path: string;
  noindex?: boolean;
}
const { title, description, path, noindex } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const siteTitle = "Crack Unit";
const fullTitle = path === "/" ? siteTitle : `${title} — ${siteTitle}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/feed/" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={path.startsWith("/20") ? "article" : "website"} />
    {description && <meta property="og:description" content={description} />}
    <style is:global>
      :root {
        --bg: #fbfaf8;
        --fg: #1a1917;
        --muted: #6b6862;
        --rule: #e2ded7;
        --accent: #b23c17;
        --measure: 34rem;
        --serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
        --sans: ui-sans-serif, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
        --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
        color-scheme: light;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #14130f;
          --fg: #e9e5dd;
          --muted: #9a948a;
          --rule: #2e2b26;
          --accent: #e8763f;
          color-scheme: dark;
        }
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: var(--serif);
        font-size: 1.0625rem;
        line-height: 1.65;
        font-synthesis-weight: none;
      }
      .wrap { max-width: var(--measure); margin: 0 auto; padding: 0 1.25rem; }
      .wide { max-width: 52rem; }

      header.site {
        border-bottom: 1px solid var(--rule);
        margin-bottom: 3rem;
      }
      header.site .wrap {
        display: flex; align-items: baseline; gap: 1.25rem;
        padding-top: 1.5rem; padding-bottom: 1.5rem;
        font-family: var(--sans);
      }
      header.site a.brand {
        font-weight: 650; letter-spacing: -0.01em; font-size: 1.05rem;
        text-decoration: none; color: var(--fg);
      }
      header.site nav { margin-left: auto; display: flex; gap: 1rem; font-size: 0.875rem; }
      header.site nav a { color: var(--muted); text-decoration: none; }
      header.site nav a:hover { color: var(--accent); }

      a { color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: 2px; }

      h1, h2, h3 { line-height: 1.2; letter-spacing: -0.015em; font-weight: 600; }
      h1 { font-size: 1.9rem; margin: 0 0 0.35rem; }
      h2 { font-size: 1.35rem; margin: 2.25rem 0 0.6rem; }
      h3 { font-size: 1.1rem; }

      .meta {
        font-family: var(--sans); font-size: 0.8125rem; color: var(--muted);
        letter-spacing: 0.01em;
      }
      .meta a { color: var(--muted); }
      .meta a:hover { color: var(--accent); }

      article.post { margin-bottom: 3.5rem; }
      article.post header { margin-bottom: 1.25rem; }
      .prose > *:first-child { margin-top: 0; }
      .prose img, .prose video, .prose iframe {
        max-width: 100%; height: auto; display: block; border-radius: 2px;
      }
      .prose iframe { width: 100%; aspect-ratio: 16 / 9; border: 0; }
      .prose blockquote {
        margin: 1.5rem 0; padding-left: 1.1rem;
        border-left: 2px solid var(--rule); color: var(--muted); font-style: italic;
      }
      .prose pre {
        background: color-mix(in srgb, var(--fg) 5%, transparent);
        padding: 0.9rem 1rem; overflow-x: auto; border-radius: 3px;
        font-family: var(--mono); font-size: 0.85rem; line-height: 1.5;
      }
      .prose code { font-family: var(--mono); font-size: 0.875em; }
      .prose hr { border: 0; border-top: 1px solid var(--rule); margin: 2.5rem 0; }
      .prose table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
      .prose td, .prose th { border-bottom: 1px solid var(--rule); padding: 0.4rem 0.5rem; text-align: left; }

      ul.index { list-style: none; padding: 0; margin: 0; }
      ul.index li { padding: 1rem 0; border-bottom: 1px solid var(--rule); }
      ul.index h2 { margin: 0 0 0.15rem; font-size: 1.15rem; }
      ul.index h2 a { color: var(--fg); text-decoration: none; }
      ul.index h2 a:hover { color: var(--accent); }
      ul.index p { margin: 0.3rem 0 0; color: var(--muted); font-size: 0.95rem; }

      .terms { display: flex; flex-wrap: wrap; gap: 0.4rem 0.7rem; font-family: var(--sans); font-size: 0.8125rem; }
      .terms a { color: var(--muted); text-decoration: none; }
      .terms a:hover { color: var(--accent); text-decoration: underline; }

      .pager {
        display: flex; justify-content: space-between; gap: 1rem;
        margin: 3rem 0; font-family: var(--sans); font-size: 0.875rem;
      }
      footer.site {
        margin-top: 5rem; padding: 2rem 0 3rem;
        border-top: 1px solid var(--rule);
        font-family: var(--sans); font-size: 0.8125rem; color: var(--muted);
      }
      footer.site a { color: var(--muted); }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap wide">
        <a class="brand" href="/">Crack Unit</a>
        <nav>
          <a href="/on-this-day/">On this day</a>
          <a href="/archive/">Archive</a>
          <a href="/contact/">Contact</a>
          <a href="/feed/">RSS</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">
      <div class="wrap wide">
        Iain Tait, since 2005. <a href="/feed/">RSS</a>.
      </div>
    </footer>
  </body>
</html>
