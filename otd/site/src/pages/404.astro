---
import Base from "../layouts/Base.astro";

const title = "Not found · crackunit on this day";
---

<Base title={title} description="That day isn't here." path="/404/">
  <section class="block blue">
    <p class="date mono">404</p>
    <p class="line">That day isn't here.</p>
  </section>
  <section class="block white">
    <a class="cta-link" href="/">Back to the calendar →</a>
  </section>
</Base>
